# =============================================================================
# Matrix Starter — Docker environment
# Copy to .env.docker:  cp .env.docker.example .env.docker
# =============================================================================

# Runtime flag (used by flexi-install — do not change)
MATRIX_RUNTIME=docker

# Site URL (must match WP_PORT mapping)
WP_HOME=http://localhost:8080/
BASE_URL=http://localhost:8080/
WP_PORT=8080

# Theme folder name under wp-content/themes/
THEME_SLUG=matrix-starter

# WordPress root inside containers
WP_PATH=/var/www/html

# Database (must match docker-compose db service)
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
DB_HOST=db

# Fresh install admin (bootstrap only)
WP_SITE_TITLE="Matrix Starter"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=matrix2026
WP_ADMIN_EMAIL=devs@matrixinternet.ie

# WordPress debug
WORDPRESS_DEBUG=1

# Private Matrix plugins — one of:
#   • gh auth login on host + mount ~/.config/gh in compose (optional)
#   • GH_TOKEN with read access to Matrix-Internet repos
GH_TOKEN=
# GITHUB_TOKEN=

MATRIX_GITHUB_ORG=Matrix-Internet
# MATRIX_GITHUB_FALLBACK_ORG=bernardhanna

# flexi-install timeouts
WP_TIMEOUT=15
WP_TIMEOUT_INSTALL=180

# Optional: Mailpit (npm run docker:mail)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Optional: staging password override
# MATRIX_SITE_PASSWORD=matrix2026
